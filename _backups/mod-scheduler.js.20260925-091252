// ── JC List (status chip + owner category + search + sort) ──
let omOwnerFilter='ALL', omSortBy='ref', omSearchQ='';
function omApplyJCFilters(){
  let list=omJcData.slice();
  if(omFilter!=='ALL') list=list.filter(r=>omFstr(r.fields,OM_F.JC_STAT)===omFilter);
  if(omOwnerFilter!=='ALL') list=list.filter(r=>omFstr(r.fields,OM_F.JC_OWNER)===omOwnerFilter);
  if(omSearchQ){ const q=omSearchQ.toLowerCase(); list=list.filter(r=>
    omFstr(r.fields,OM_F.JC_REF).toLowerCase().includes(q)||
    omFstr(r.fields,OM_F.JC_TITLE).toLowerCase().includes(q)||
    omCli(r.fields).toLowerCase().includes(q)||
    omFstr(r.fields,OM_F.JC_STAT).toLowerCase().includes(q)||
    omFstr(r.fields,OM_F.JC_OWNER).toLowerCase().includes(q)); }
  const g=(r,fld)=>omFstr(r.fields,fld)||'';
  list.sort((a,b)=>{
    if(omSortBy==='owner'){ const c=g(a,OM_F.JC_OWNER).localeCompare(g(b,OM_F.JC_OWNER)); if(c)return c; return g(b,OM_F.JC_REF).localeCompare(g(a,OM_F.JC_REF)); }
    if(omSortBy==='status') return g(a,OM_F.JC_STAT).localeCompare(g(b,OM_F.JC_STAT))||g(b,OM_F.JC_REF).localeCompare(g(a,OM_F.JC_REF));
    if(omSortBy==='due'){ const da=a.fields[OM_F.JC_DUE]||'9999',db=b.fields[OM_F.JC_DUE]||'9999'; return String(da).localeCompare(String(db)); }
    return g(b,OM_F.JC_REF).localeCompare(g(a,OM_F.JC_REF)); // ref, newest first
  });
  omRenderList(list);
}
function omFilteredJCs(){return omJcData;} // retained for callers; render goes through omApplyJCFilters
function omRenderList(list){document.getElementById('om-jclist').innerHTML=list.length?list.map(omJcCard).join(''):'<div class="om-empty">No job cards found</div>';}
function omSetFilter(el,s){document.querySelectorAll('.om-chip').forEach(c=>c.classList.remove('on'));el.classList.add('on');omFilter=s;omApplyJCFilters();}
function omSetOwner(v){omOwnerFilter=v;omApplyJCFilters();}
function omSetSort(v){omSortBy=v;omApplyJCFilters();}
function omFilterJCs(q){omSearchQ=q;omApplyJCFilters();}

// ── Tickets: list ──────────────────────────────────────────────────────────
//
// Read once and cached in omTktData, the same way job cards are. Emptying omTktData is how
// anything that changes a ticket asks for a re-read.
async function omLoadTickets(force){
  if(omTktData.length && !force) return omTktData;
  omTktData = await tktAll();
  // Newest first. A service desk reads top-down and the newest fault is the live one.
  omTktData.sort((a,b)=>String(b.fields[TK.ref]||'').localeCompare(String(a.fields[TK.ref]||'')));
  return omTktData;
}

const OM_TKT_OPEN = ['New','Assigned','In Progress','Awaiting Spares','Awaiting Client',
  'Second Visit Required','Second Visit Scheduled'];

/** The job card a ticket hangs off, when the role can see it. */
function omTktJc(rec){
  const id=[].concat(rec.fields[TK.jc]||[])[0];
  return id?omJcData.find(r=>r.id===id):null;
}

function omTktCard(rec){
