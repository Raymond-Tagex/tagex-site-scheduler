function omFilteredTkts(){
  let list=omTktData.slice();
  if(omTktFilter==='OPEN') list=list.filter(r=>OM_TKT_OPEN.includes(omFstr(r.fields,TK.status)||'New'));
  else if(omTktFilter!=='ALL') list=list.filter(r=>(omFstr(r.fields,TK.status)||'New')===omTktFilter);
  const q=omTktSearchQ.trim().toLowerCase();
  if(q){
    list=list.filter(r=>{
      const f=r.fields, jc=omTktJc(r);
      const hay=[omFstr(f,TK.ref),omFstr(f,TK.subject),omFstr(f,TK.desc),omFstr(f,TK.reportedBy),
        omFstr(f,TK.channel),omFstr(f,TK.category),omFstr(f,TK.status),
        jc?omFstr(jc.fields,OM_F.JC_REF):'', jc?omCli(jc.fields):''].join(' ').toLowerCase();
      return hay.includes(q);
    });
  }
  return list;
}

function omBuildTktChips(){
  const host=document.getElementById('om-tktchips'); if(!host)return;
  const count=(s)=>s==='ALL'?omTktData.length
    :s==='OPEN'?omTktData.filter(r=>OM_TKT_OPEN.includes(omFstr(r.fields,TK.status)||'New')).length
    :omTktData.filter(r=>(omFstr(r.fields,TK.status)||'New')===s).length;
  const chips=['OPEN','ALL'].concat(TICKET_STATUSES);
  host.innerHTML=chips.map(c=>'<div class="om-chip'+(omTktFilter===c?' on':'')
    +'" data-act="omSetTktFilter" data-a1="@el" data-a2="'+esc(c)+'">'
    +esc(c==='OPEN'?'Open':c==='ALL'?'All':c)+' <b>'+count(c)+'</b></div>').join('');
}

function omRenderTickets(){
