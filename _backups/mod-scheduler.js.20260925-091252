async function omSubmit(){
  const msg=document.getElementById('om-newmsg');
  const fail=(t)=>{msg.innerHTML='<div class="om-err">\u26a0 '+esc(t)+'</div>';};
  const cat=document.getElementById('om-cat').value;
  const subj=document.getElementById('om-subj').value.trim();
  const jcId=omSelJCId||document.getElementById('om-jcsel').value;
  if(!cat||!subj) return fail('Category and Subject are required');
  if(!jcId) return fail('Select a Job Card');
  // Mandatory: "how did this reach us" is the question nobody remembers to ask later.
  if(!omChannel) return fail('Choose how this was reported');

  const rep=document.getElementById('om-rep').value.trim();
  const asset=document.getElementById('om-asset').value.trim();
  const err=document.getElementById('om-err').value.trim();
  const desc=document.getElementById('om-desc').value.trim();
  const detail=document.getElementById('om-chandetail').value.trim();
  const atRaw=document.getElementById('om-reportedat').value;

  document.getElementById('om-subtxt').innerHTML='<span class="om-sp"></span> Submitting\u2026';
  msg.innerHTML='';
  try{
    // The job card's client comes across so the ticket stands on its own. A job card whose
    // client the role may not read simply yields no link rather than failing the save.
    const jc=omJcData.find(r=>r.id===jcId);
    const cli=jc?[].concat(jc.fields[OM_F.JC_CLI]||[]):[];

    const f={
      [TK.jc]:[jcId],
      [TK.channel]:omChannel,
      [TK.category]:cat,
      [TK.subject]:subj,
      [TK.priority]:omPriVal,
      [TK.status]:'New',
      [TK.createdBy]:(TX.me()&&TX.me().user&&TX.me().user.email)||'',
      [TK.reportedAt]:atRaw?sastFieldsToUtcISO(atRaw):new Date().toISOString(),
    };
    if(cli.length) f[TK.client]=cli;
    if(desc)   f[TK.desc]=desc;
    if(rep)    f[TK.reportedBy]=rep;
    if(asset)  f[TK.asset]=asset;
    if(err)    f[TK.errCode]=err;
    if(detail) f[TK.channelDetail]=detail;

    const rec=await tktCreate(f);
    // Ticket Ref is a formula, so it exists the moment the record does. No second write, and
    // no window in which a ticket has no reference.
    const ref=(rec&&rec.fields&&rec.fields[TK.ref])||'';

    // Linked to BOTH the job card and the ticket. Filtering the log by job card and a date
    // window would sweep in entries belonging to other tickets on the same installation.
    try{
      await omPost(OM_T.ACT,{
        [OM_F.AL_NOTE]:'['+ref+'] ['+omChannel+'] ['+cat+'] ['+omPriVal+'] '+subj
          +(desc?'\n\n'+desc:'')+(rep?'\nReported by: '+rep:'')
          +(detail?'\nSource: '+detail:''),
        [OM_F.AL_JC]:[jcId],
        [OM_F.AL_TICKET]:[rec.id],
        [OM_F.AL_TYPE]:'Ticket Logged',
      });
    }catch(logErr){
      // The ticket is saved and that is the record that matters. Say what did not happen
      // rather than implying the whole thing failed.
      msg.innerHTML='<div class="om-ok">\u2713 Ticket '+esc(ref)+' logged</div>'
        +'<div class="om-err">\u26a0 Its activity-log entry could not be written: '+esc(logErr.message)+'</div>';
      document.getElementById('om-subtxt').textContent='\ud83d\udce4 Submit Ticket';
      omTktData=[];
      return;
    }

    msg.innerHTML='<div class="om-ok">\u2713 Ticket '+esc(ref)+' logged</div>';
    omResetTicketForm();
    omTktData=[];                       // the list re-reads next time it is opened
    setTimeout(()=>omGoView('jc'),1500);
  }catch(e){
    fail(e.message);
  }
  document.getElementById('om-subtxt').textContent='\ud83d\udce4 Submit Ticket';
}

// ── Triage ──
function omTriScore(rec){
  const f=rec.fields,s=omFstr(f,OM_F.JC_STAT),p=omFstr(f,OM_F.JC_PRI);
  if(['Completed','Closed','Cancelled'].includes(s))return -1;
  let sc=0;
  if(p==='Critical')sc+=100;else if(p==='High')sc+=50;else if(p==='Medium')sc+=20;
  if(omOver(rec))sc+=Math.min(Math.abs(f[OM_F.JC_DAYS]||0)*2,60);
  if(s==='In Progress')sc+=10; if(s==='New')sc+=5;
  return sc;
}
function omRenderTriage(){
  const el=document.getElementById('om-triage');
  if(!omJcData.length){el.innerHTML='<div class="om-empty">No data</div>';return;}
  const open=omJcData.filter(r=>omTriScore(r)>=0).sort((a,b)=>omTriScore(b)-omTriScore(a));
  const crit=open.filter(r=>{const p=omFstr(r.fields,OM_F.JC_PRI),d=r.fields[OM_F.JC_DAYS]||0;return p==='Critical'||(omOver(r)&&Math.abs(d)>7);});
  const urg=open.filter(r=>{const p=omFstr(r.fields,OM_F.JC_PRI);return!crit.includes(r)&&(omOver(r)||p==='High');});
  const prog=open.filter(r=>!crit.includes(r)&&!urg.includes(r)&&omFstr(r.fields,OM_F.JC_STAT)==='In Progress');
  const pend=open.filter(r=>!crit.includes(r)&&!urg.includes(r)&&!prog.includes(r));
  el.innerHTML=`
    <div style="font-family:monospace;font-size:9px;color:var(--muted2);padding:7px 10px;background:var(--surface);border:1px solid var(--line);border-radius:8px;margin-bottom:12px;">${open.length} open tickets · sorted by urgency · tap to view</div>
    <div class="om-bucket"><div class="om-bhdr b-crit">🔴 Critical &amp; Long Overdue<span class="om-bcnt">${crit.length}</span></div>${crit.length?crit.map(omJcCard).join(''):'<div class="om-trie">✓ None</div>'}</div>
    <div class="om-bucket"><div class="om-bhdr b-warn">🟡 Overdue &amp; High Priority<span class="om-bcnt">${urg.length}</span></div>${urg.length?urg.map(omJcCard).join(''):'<div class="om-trie">✓ None</div>'}</div>
    <div class="om-bucket"><div class="om-bhdr b-prog">🔵 In Progress<span class="om-bcnt">${prog.length}</span></div>${prog.length?prog.map(omJcCard).join(''):'<div class="om-trie">No active work</div>'}</div>
    <div class="om-bucket"><div class="om-bhdr b-pend">⚪ Pending<span class="om-bcnt">${pend.length}</span></div>${pend.length?pend.map(omJcCard).join(''):'<div class="om-trie">Nothing pending</div>'}</div>`;
}

