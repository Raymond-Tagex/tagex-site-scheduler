// ── job card sheet: extra field renderers ───────────────────────────────────
//
// A field the role may not read is ABSENT from the record, not empty — the proxy removes it
// before the browser sees it. So `undefined` means "not permitted" and the row is skipped
// entirely, while a permitted-but-blank value still draws, so a real gap stays visible and
// can be filled in. Drawing an empty row for a denied field would tell a technician that the
// field exists and happens to be empty, which is a different fact and not theirs to have.
function omRow(label, html){
  return html == null ? '' :
    `<div class="om-df"><label>${label}</label><div style="font-size:13px;">${html}</div></div>`;
}
function omOpt(f, id){
  if (!(id in f)) return null;
  return omFstr(f, id) || '<span style="color:var(--muted2)">—</span>';
}
function omLinkCount(f, id, noun){
  if (!(id in f)) return null;
  const n = Array.isArray(f[id]) ? f[id].length : (f[id] ? 1 : 0);
  if (!n) return '<span style="color:var(--muted2)">none</span>';
  return `<span style="font-family:monospace;font-size:12px;color:var(--accent)">${n}</span> ${noun}${n === 1 ? '' : 's'}`;
}
// Health and SLA are traffic lights in Airtable; show the colour, not only the word.
const OM_LIGHT = { Green:'#3ecf8e', Amber:'#f0c000', Yellow:'#f0c000', Orange:'#ff9f43', Red:'#ef5d5d' };
function omLight(f, id){
  if (!(id in f)) return null;
  const v = omFstr(f, id);
  if (!v) return '<span style="color:var(--muted2)">—</span>';
  const c = OM_LIGHT[v] || 'var(--muted)';
  return `<span style="display:inline-flex;align-items:center;gap:7px"><span style="width:9px;height:9px;border-radius:50%;background:${c};flex:none"></span>${v}</span>`;
}

function omPrCls(p){return{Critical:'p-crit',High:'p-high',Medium:'p-med',Low:'p-low'}[p]||'p-low';}
function omInits(n){if(!n||n==='—')return'?';const p=n.trim().split(' ');return p.length>=2?(p[0][0]+p[p.length-1][0]).toUpperCase():n.slice(0,2).toUpperCase();}
function omAgo(d){if(!d)return'—';const dy=Math.floor((new Date()-new Date(d))/86400000);if(dy<0)return`In ${Math.abs(dy)}d`;if(dy===0)return'Today';if(dy===1)return'Yesterday';return`${dy}d ago`;}

