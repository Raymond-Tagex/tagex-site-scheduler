async function saveVisit(wrap){
  const m=collectModal(wrap);
  if(!m.jcId){ toast("Select a Job Card first","bad"); return; }
  if(!m.start||!m.end){ toast("Start and End are required","bad"); return; }
  const startISO=sastFieldsToUtcISO(m.start), endISO=sastFieldsToUtcISO(m.end);
  if(new Date(endISO)<=new Date(startISO)){ toast("End must be after Start","bad"); return; }

  // ---- conflict detection ----
  if(m.techId && ACTIVE_STATUSES.includes(m.status) && !pendingConflictOverride){
    const sMs=new Date(startISO).getTime(), eMs=new Date(endISO).getTime();
    const clash=DATA.visits.map(normVisit).find(v=>{
      if(v.id===editingId) return false;
      if(!v.techIds.includes(m.techId)) return false;
      if(!ACTIVE_STATUSES.includes(v.status)) return false;
      const vs=new Date(v.start).getTime(), ve=v.end?new Date(v.end).getTime():vs+3600000;
      return sMs<ve && vs<eMs;
    });
    if(clash){
      const box=wrap.querySelector("#mConflict");
      box.classList.remove("hidden");
      box.innerHTML=`<span>⚠️</span><div><b>${esc(peopleById[m.techId]||"Technician")}</b> already assigned to
        <b>${esc(jcRef(clash.jcIds[0])||clash.subject)}</b> on ${fmtDateTime(clash.start)}.
        <div style="margin-top:8px;display:flex;gap:8px"><button class="btn sm" id="ovrBtn">Override &amp; save anyway</button></div></div>`;
      wrap.querySelector("#ovrBtn").onclick=()=>{ pendingConflictOverride=true; box.classList.add("hidden"); saveVisit(wrap); };
      return;
    }
  }

  const fields={
    [F.subject]:m.subject||((jobcardById[m.jcId]?.[JC.ref]||"")+" - "+(jobcardById[m.jcId]?.[JC.title]||"")),
    [F.jobcard]:[m.jcId],
    [F.start]:startISO,[F.end]:endISO,
    [F.vtype]:m.type,[F.priority]:m.prio,[F.status]:m.status,
    [F.notes]:m.notes
  };
  if(modalTicketId && !editingId) fields[F.ticket]=[modalTicketId];
  if(m.techId) fields[F.tech]=[m.techId]; else fields[F.tech]=[];
  fields[F.attendees]=m.atts;
  // Identity now comes from the signed-in session, not a prompt() the user typed once.
  if(!editingId) fields[F.createdBy]=TX.userEmail()||"unknown";

  const btn=wrap.querySelector("#mSave"); btn.disabled=true; btn.textContent="Saving…";
  try{
    let rec, action, msg;
    if(editingId){
      const before=normVisit(DATA.visits.find(r=>r.id===editingId));
      rec=await atUpdate(T.visits, editingId, fields, true);
      // reschedule detection
      if(before.start!==startISO || before.end!==endISO){
        action="Visit Rescheduled";
        msg=`Site visit moved from ${fmtDateTime(before.start)} to ${fmtDateTime(startISO)} (${m.subject||jcRef(m.jcId)})`;
      } else if(before.status!==m.status && m.status==="Completed"){
        action="Visit Completed"; msg=`Site visit completed by ${peopleById[m.techId]||"technician"} (${m.subject||jcRef(m.jcId)})`;
      } else { action=null; }
      // update local
      const idx=DATA.visits.findIndex(r=>r.id===editingId); if(idx>=0) DATA.visits[idx]=rec;
    } else {
      rec=await atCreate(T.visits, fields, true);
      DATA.visits.push(rec);
      action="Visit Scheduled";
      msg=`Site visit scheduled for ${fmtDateTime(startISO)} by ${TX.userName()||TX.userEmail()||"unknown"} (${m.subject||jcRef(m.jcId)})`;
    }
    if(action) await logActivity(m.jcId, action, msg);

    // ── the ticket side of a second visit ──────────────────────────────────
    // The visit is saved by this point. Anything that fails from here on is reported
    // precisely, because "save failed" over a visit that DID save is how someone ends up
    // booking it twice.
    let ticketProblems=[];
    if(modalTicketId && !editingId){
      const problems=ticketProblems;
      const saved=[];
      for(const line of modalSpares){
        try{
          await spareCreate({
            [TKS.ticket]:[modalTicketId], [TKS.visit]:[rec.id],
            [TKS.code]:line.code, [TKS.desc]:line.desc, [TKS.unit]:line.unit,
            [TKS.srcId]:line.id, [TKS.qtyReq]:line.qty, [TKS.status]:'Requested',
          });
          saved.push(line);
        }catch(e){ problems.push(line.code+': '+e.message); }
      }
      // Parts asked for before a date existed now belong to this trip.
      let adopted=0;
      try{
        const loose=(await spareAll()).filter(sp=>
          [].concat(sp.fields[TKS.ticket]||[]).includes(modalTicketId)
          && !([].concat(sp.fields[TKS.visit]||[]).length));
        for(const sp of loose){
          await TX.api({ op:'update', base:'OM', table:'tickets', sub:'spares',
            recordId:sp.id, fields:{ [TKS.visit]:[rec.id] } });
          adopted++;
        }
      }catch(e){ problems.push('attaching the spares already requested: '+e.message); }

      try{
        await tktUpdate(modalTicketId,{
          [TK.status]: (saved.length||adopted)?'Awaiting Spares':'Second Visit Scheduled' });
      }catch(e){ problems.push('the ticket status: '+e.message); }
      if(saved.length){
        try{
          await omPost(OM_T.ACT,{
            [OM_F.AL_NOTE]:'Spares requested for the visit on '+fmtDateTime(startISO)+':\n'
              +saved.map(l=>l.qty+' \u00d7 '+l.code+(l.desc?' ('+l.desc+')':'')).join('\n'),
            [OM_F.AL_JC]:[m.jcId],
            [OM_F.AL_TICKET]:[modalTicketId],
            [OM_F.AL_TYPE]:'Spares Requested',
          });
        }catch(e){ problems.push('the spares activity entry: '+e.message); }
      }
      omTktData=[];                       // the list and detail re-read
    }
    closeModal();
    // ONE toast, and the bad news wins. This used to raise the problem and then immediately
    // overwrite it with "Visit scheduled — syncing…", so a part that failed to save was
    // reported to nobody: the visit went in the diary and the spare was never ordered.
    if(ticketProblems.length){
      toast('Visit saved, but these did not: '+ticketProblems.join('; '),'bad');
    } else {
      toast(editingId?"Visit updated — syncing…":"Visit scheduled — syncing…","ok");
    }
    // Reload from Airtable so calendar reflects true state for all users
    loadAll(true).then(refreshAllViews)
      .catch(()=>refreshAllViews()); // fallback: use local data if reload fails
  }catch(err){ toast("Save failed: "+err.message,"bad"); btn.disabled=false; btn.textContent="Save Visit"; }
}

async function cancelVisit(id){
  if(!confirm("Mark this visit as Cancelled? (record is kept, not deleted)")) return;
  try{
    const v=normVisit(DATA.visits.find(r=>r.id===id));
    const rec=await atUpdate(T.visits,id,{[F.status]:"Cancelled"},true);
    const idx=DATA.visits.findIndex(r=>r.id===id); if(idx>=0) DATA.visits[idx]=rec;
    await logActivity(v.jcIds[0],"Visit Cancelled",`Site visit cancelled (${v.subject||jcRef(v.jcIds[0])}) — was ${fmtDateTime(v.start)}`);
    closeModal(); toast("Visit cancelled — syncing…","ok");
    loadAll(true).then(refreshAllViews).catch(()=>refreshAllViews());
  }catch(err){ toast("Failed: "+err.message,"bad"); }
}

async function rescheduleToDate(id, newDateKey){
  const v=normVisit(DATA.visits.find(r=>r.id===id));
  if(!v.start) return;
  const oldStart=utcToSast(v.start), oldEnd=v.end?utcToSast(v.end):new Date(oldStart.getTime()+3600000);
  const durMin=(oldEnd-oldStart)/60000;
  const [y,mo,da]=newDateKey.split("-").map(Number);
  const newStartLocal=`${newDateKey}T${String(oldStart.getUTCHours()).padStart(2,"0")}:${String(oldStart.getUTCMinutes()).padStart(2,"0")}`;
  const newStartISO=sastFieldsToUtcISO(newStartLocal);
  const newEndISO=new Date(new Date(newStartISO).getTime()+durMin*60000).toISOString();
  try{
    const rec=await atUpdate(T.visits,id,{[F.start]:newStartISO,[F.end]:newEndISO,[F.status]:"Rescheduled"},true);
    const idx=DATA.visits.findIndex(r=>r.id===id); if(idx>=0) DATA.visits[idx]=rec;
    await logActivity(v.jcIds[0],"Visit Rescheduled",`Site visit moved from ${fmtDateTime(v.start)} to ${fmtDateTime(newStartISO)} (drag-drop)`);
    toast("Visit rescheduled — syncing…","ok");
    loadAll(true).then(refreshAllViews).catch(()=>refreshAllViews());
  }catch(err){ toast("Reschedule failed: "+err.message,"bad"); }
}

async function logActivity(jcId, actionType, text){
  if(!jcId) return;
  try{
    await atCreate(T.activity,{ [AL.update]:text, [AL.jobcard]:[jcId], [AL.actionType]:actionType }, true);
  }catch(err){ console.warn("Activity log write failed:",err.message); toast("Visit saved, but Activity Log write failed: "+err.message,"bad"); }
}

