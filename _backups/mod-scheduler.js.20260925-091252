  // ══════════════════════════════════════════════════════════════════════════
  // DECLARATIVE EVENT DISPATCH
  //
  // Replaces the 44 inline on*= handlers this module used to carry. Those are blocked by the
  // Content-Security-Policy, and relaxing the policy for one module would weaken it for the
  // whole application — the delivery note app included.
  //
  // Markup now says what it wants:
  //     <button data-act="omGoView" data-a1="jc">
  //     <input data-on="input" data-act="omFilterJCs" data-a1="@val">
  //
  // One listener per event type on the module root handles all of it, including markup this
  // module generates at runtime — no rebinding after a re-render.
  // ══════════════════════════════════════════════════════════════════════════

  // Only these can be triggered from markup. A name not on the list does nothing, so a
  // stray or injected data-act cannot reach anything it was not meant to.
  function actionRegistry() {
    const reg = {};
    const add = (name, fn) => { if (typeof fn === 'function') reg[name] = fn; };
    add('omGoView', typeof omGoView === 'function' ? omGoView : null);
    add('omSetFilter', typeof omSetFilter === 'function' ? omSetFilter : null);
    add('omSelPri', typeof omSelPri === 'function' ? omSelPri : null);
    add('omSelChan', typeof omSelChan === 'function' ? omSelChan : null);
    add('omSetTktFilter', typeof omSetTktFilter === 'function' ? omSetTktFilter : null);
    add('omFilterTkts', typeof omFilterTkts === 'function' ? omFilterTkts : null);
    add('omOpenTicket', typeof omOpenTicket === 'function' ? omOpenTicket : null);
    add('omCloseTicket', typeof omCloseTicket === 'function' ? omCloseTicket : null);
    add('omTktStatus', typeof omTktStatus === 'function' ? omTktStatus : null);
    add('omSecondVisit', typeof omSecondVisit === 'function' ? omSecondVisit : null);
    add('omTktReport', typeof omTktReport === 'function' ? omTktReport : null);
    add('omTktPickSpare', typeof omTktPickSpare === 'function' ? omTktPickSpare : null);
    add('omTktSpareStep', typeof omTktSpareStep === 'function' ? omTktSpareStep : null);
    add('omTktRequestSpares', typeof omTktRequestSpares === 'function' ? omTktRequestSpares : null);
    add('omTktAttachJc', typeof omTktAttachJc === 'function' ? omTktAttachJc : null);
    add('omFilterJCs', typeof omFilterJCs === 'function' ? omFilterJCs : null);
    add('omCliTab', typeof omCliTab === 'function' ? omCliTab : null);
    add('omCliPick', typeof omCliPick === 'function' ? omCliPick : null);
    add('omJCPick', typeof omJCPick === 'function' ? omJCPick : null);
    add('omRefBuild', typeof omRefBuild === 'function' ? omRefBuild : null);
    add('omSetOwner', typeof omSetOwner === 'function' ? omSetOwner : null);
    add('omSetSort', typeof omSetSort === 'function' ? omSetSort : null);
    add('omSubmit', typeof omSubmit === 'function' ? omSubmit : null);
    add('omSubmitNewJC', typeof omSubmitNewJC === 'function' ? omSubmitNewJC : null);
    add('omCloseDetail', typeof omCloseDetail === 'function' ? omCloseDetail : null);
    add('omOpenDetail', typeof omOpenDetail === 'function' ? omOpenDetail : null);
    add('omUpdStat', typeof omUpdStat === 'function' ? omUpdStat : null);
    add('omUpdProg', typeof omUpdProg === 'function' ? omUpdProg : null);
    add('omUpdDue', typeof omUpdDue === 'function' ? omUpdDue : null);
    add('omLogNote', typeof omLogNote === 'function' ? omLogNote : null);
    add('omAddNote', typeof omAddNote === 'function' ? omAddNote : null);
    add('dashApply', typeof dashApply === 'function' ? dashApply : null);
    add('dashClear', typeof dashClear === 'function' ? dashClear : null);
    add('openDetail', typeof openDetail === 'function' ? openDetail : null);
    add('omProgPreview', omProgPreview);
    return reg;
  }

  /** Live preview while dragging the progress slider; the commit happens on change. */
  function omProgPreview(id, value) {
    const bar = document.getElementById('om-pb-' + id);
    const label = document.getElementById('om-pv-' + id);
    if (bar) bar.style.width = value + '%';
    if (label) label.textContent = value + '%';
  }

  function resolveArg(raw, el) {
    if (raw === '@el') return el;
    if (raw === '@val') return el.value;
    if (raw === '@checked') return el.checked;
    return raw;
  }

  function dispatch(evtName, e, reg) {
    // `data-on` names the event; its absence means click.
    const sel = evtName === 'click'
      ? '[data-act]:not([data-on]), [data-on="click"]'
      : `[data-on="${evtName}"], [data-on2="${evtName}"]`;
    const el = e.target.closest(sel);
    if (!el || !el.closest('#schedApp')) return;

    const secondary = el.getAttribute('data-on2') === evtName;
    const name = secondary ? el.getAttribute('data-act2') : el.getAttribute('data-act');
    const fn = reg[name];
    if (!fn) return;

    const prefix = secondary ? 'b' : 'a';
    const args = [];
    for (let i = 1; i <= 6; i++) {
      const v = el.getAttribute(`data-${prefix}${i}`);
      if (v === null) break;
      args.push(resolveArg(v, el));
    }
    try { fn.apply(null, args); }
    catch (err) { console.error(`[scheduler] ${name} failed:`, err); }
  }

  function bindDispatch(root) {
    const reg = actionRegistry();
    ['click', 'change', 'input'].forEach((evtName) => {
      root.addEventListener(evtName, (e) => dispatch(evtName, e, reg));
    });
  }

  // ══════════════════════════════════════════════════════════════════════════
  // BOOT — runs when the platform reports a signed-in session
  // ══════════════════════════════════════════════════════════════════════════

  async function start() {
    if (booted) return;

    // Not rendered at all for a role without site visits. The tab is removed too, so this
    // is a backstop rather than the primary control.
    if (!TX.can('site_visits', 'view')) return;

    booted = true;
    try {
      wireScheduler();
      bindDispatch(document.getElementById('schedApp'));
      await loadAll();
      refreshFilters();
      render();
      startAutoRefresh();
    } catch (e) {
      booted = false;
      const host = document.getElementById('calHost');
      if (host) {
        host.innerHTML = '<div class="om-err" style="margin:20px">Could not load the schedule: '
          + TX.esc(TX.errorText(e)) + '</div>';
      }
    }
  }

  function stop() {
    booted = false;
    try { clearInterval(_autoRefreshTimer); } catch (e) { /* never started */ }
  }

  // Exposed so the page can start this module once a session exists, rather than loading
  // four Airtable tables before anyone has signed in. In the combined operations platform
  // the module shell calls this the first time the Scheduler tab is opened; here boot.js
  // calls it on auth:ready.
  TX.scheduler = { start, stop, isBooted: () => booted };
  TX.on('auth:signedout', stop);
})();
