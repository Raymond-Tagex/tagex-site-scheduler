function renderDashboard(){
  const vis=DATA.visits.map(normVisit).filter(v=>v.start);
  const todayKey=dateToKey(new Date());
  const now=new Date();
  const wkStart=startOfWeek(now), wkEnd=new Date(wkStart); wkEnd.setDate(wkStart.getDate()+7);

  const today=vis.filter(v=>dayKey(v.start)===todayKey);
  const week=vis.filter(v=>{ const d=new Date(v.start); return d>=wkStart && d<wkEnd; });
  const activeNow=vis.filter(v=>ACTIVE_STATUSES.includes(v.status));
  const completedWk=week.filter(v=>v.status==="Completed");
  const emergWk=week.filter(v=>v.type==="Emergency Callout");

  // per-technician (this week)
  const perTech={};
  week.forEach(v=>{
    v.techIds.forEach(tid=>{
      const n=peopleById[tid]||"Unassigned";
      perTech[n]=perTech[n]||{visits:0,minutes:0,emerg:0};
      perTech[n].visits++;
      if(v.end) perTech[n].minutes+=(new Date(v.end)-new Date(v.start))/60000;
      if(v.type==="Emergency Callout") perTech[n].emerg++;
    });
  });
  const techRows=Object.entries(perTech).sort((a,b)=>b[1].visits-a[1].visits);
