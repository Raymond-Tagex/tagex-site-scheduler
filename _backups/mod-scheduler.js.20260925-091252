// Resolve an Activity Log entry's linked Job Card → {ref, client}.
// AL_JC returns record IDs (returnFieldsByFieldId) or {id,name} objects — handle both.
function omActJC(a){
  const l=a.fields[OM_F.AL_JC];
  const first=Array.isArray(l)?l[0]:l;
  if(!first) return {ref:'',client:''};
  const rid=(first&&typeof first==='object')?(first.id||''):first;
  const jc=omJcData.find(r=>r.id===rid);
  if(jc) return {ref:omFstr(jc.fields,OM_F.JC_REF)||'', client:omCli(jc.fields)||''};
  return {ref:(first&&typeof first==='object'&&first.name)?first.name:'', client:''};
}
async function omLoadActLog(jcId){
  try{
    const all=await omFetchFiltered(OM_T.ACT);
    return all.filter(r=>{const l=r.fields[OM_F.AL_JC];return Array.isArray(l)?l.includes(jcId):l===jcId;});
  }catch(e){return[];}
}

