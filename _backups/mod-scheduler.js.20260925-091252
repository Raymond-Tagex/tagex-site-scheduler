  // upcoming list (next 7)
  const upcoming=vis.filter(v=>new Date(v.start)>=new Date(Date.now()-3600000) && ACTIVE_STATUSES.includes(v.status))
    .sort((a,b)=>new Date(a.start)-new Date(b.start)).slice(0,8);

