  if(stockLoading) return stockLoading;
  stockLoading=(async()=>{
    const r=await TX.list('STK','stock_items',{pageSize:100});
    STOCK=(r.records||[]).map(rec=>({
      id:rec.id,
      code:String(rec.fields[STK_F.code]||'').trim(),
      desc:String(rec.fields[STK_F.desc]||'').trim(),
      unit:String(rec.fields[STK_F.unit]||'').trim(),
    })).filter(x=>x.code||x.desc);
    return STOCK;
  })();
  try{ return await stockLoading; } finally { stockLoading=null; }
}

/** The chosen lines, above the picker, each with a stepper and a way out. */
function renderSpareLines(wrap){
  const host=wrap.querySelector('#mSpareLines'); if(!host) return;
  host.innerHTML=modalSpares.length?modalSpares.map((l,i)=>
    `<div class="om-spare">
       <div class="om-sparetxt"><b>${esc(l.code)}</b><span>${esc(l.desc)}</span></div>
       <div class="om-stepper">
         <button type="button" class="om-step" data-spare="dec" data-i="${i}" aria-label="One fewer">\u2212</button>
         <span class="om-qty">${l.qty}</span>
         <button type="button" class="om-step" data-spare="inc" data-i="${i}" aria-label="One more">+</button>
         <button type="button" class="om-step om-x" data-spare="rm" data-i="${i}" aria-label="Remove">\u00d7</button>
       </div>
     </div>`).join('')
    :'<div class="om-empty" style="padding:10px">Nothing listed yet.</div>';
}

function wireSpares(wrap){
  const sel=wrap.querySelector('#mSpareSel');
  const msg=wrap.querySelector('#mSpareMsg');

  wrap.querySelector('#mSpareLines').addEventListener('click',(e)=>{
    const b=e.target.closest('[data-spare]'); if(!b) return;
    const i=+b.dataset.i, line=modalSpares[i]; if(!line) return;
    if(b.dataset.spare==='inc') line.qty+=1;
    else if(b.dataset.spare==='dec') line.qty=Math.max(1,line.qty-1);
    else modalSpares.splice(i,1);
    renderSpareLines(wrap);
  });

  sel.addEventListener('change',()=>{
    const item=(STOCK||[]).find(x=>x.id===sel.value);
    if(!item) return;
    const have=modalSpares.find(l=>l.id===item.id);
    // Choosing the same part twice means two of it, not a second line saying the same thing.
    if(have) have.qty+=1;
    else modalSpares.push({id:item.id,code:item.code,desc:item.desc,unit:item.unit,qty:1});
    sel.value='';
    renderSpareLines(wrap);
  });

  // Filled on first open, not on page load: most visits never touch it.
  msg.textContent='Loading the stock catalogue\u2026';
  loadStock().then((rows)=>{
    sel.innerHTML='<option value="">\u2014 search the stock catalogue \u2014</option>'
      +rows.map(x=>`<option value="${esc(x.id)}">${esc(x.code+(x.desc?' \u2014 '+x.desc:''))}</option>`).join('');
    TX.pick.scan(wrap);
    msg.textContent=rows.length+' item'+(rows.length===1?'':'s')+' \u00b7 type a code or a description';
  }).catch((e)=>{
    // A picker that silently shows nothing looks like an empty catalogue.
    msg.innerHTML='<span class="om-err">The stock catalogue could not be read: '+esc(TX.errorText(e))+'</span>';
  });
}

/** Previous visits on this ticket, shown in the modal so nobody re-books the same trip. */
function ticketHistoryHtml(ticketId){
  const prior=DATA.visits.map(normVisit)
    .filter(v=>v.ticketIds.includes(ticketId))
    .sort((a,b)=>String(a.start).localeCompare(String(b.start)));
  if(!prior.length) return '<div class="om-empty" style="padding:10px">No earlier visits on this ticket.</div>';
  return prior.map(v=>`<div class="om-tli"><div class="om-tld g"></div>
    <div class="om-tlt">${esc(fmtDate(v.start))} ${esc(fmtTime(v.start))} \u00b7 <span style="color:var(--accent)">${esc(v.type||'')}</span> \u00b7 ${esc(v.status||'')}</div>
