// ---------- MONTH ----------
function renderMonth(){
  setPeriod(`${MONTHS[cursor.getMonth()]} ${cursor.getFullYear()}`);
  const vis=filteredVisits();
  const byDay={}; vis.forEach(v=>{ const k=dayKey(v.start); (byDay[k]=byDay[k]||[]).push(v); });
  Object.values(byDay).forEach(a=>a.sort((x,y)=>new Date(x.start)-new Date(y.start)));

  const first=new Date(cursor.getFullYear(),cursor.getMonth(),1);
  const startGrid=new Date(first); startGrid.setDate(1-first.getDay());
  const todayKey=dateToKey(new Date());

  let h=`<div class="month"><div class="dow">${DOW.map(d=>`<div>${d}</div>`).join("")}</div><div class="weeks">`;
  let d=new Date(startGrid);
  for(let w=0;w<6;w++){
    h+=`<div class="week">`;
    for(let i=0;i<7;i++){
      const k=dateToKey(d);
      const dim=d.getMonth()!==cursor.getMonth()?"dim":"";
      const today=k===todayKey?"today":"";
      const evs=byDay[k]||[];
      let evHtml="";
      evs.forEach(v=>{
        const c=TYPE_COLOR[v.type]||"#9aa3ad";
        evHtml+=`<div class="ev" draggable="true" data-id="${v.id}" style="background:${c}" title="${esc(v.subject)}${v.jcIds[0]&&jcOwner(v.jcIds[0])?' — Owner: '+esc(jcOwner(v.jcIds[0])):''}">
          <span class="t">${fmtTime(v.start)}</span><span class="label-txt">${esc(v.techNames[0]||v.type||v.subject)}${v.jcIds[0]&&jcClient(v.jcIds[0])?' · '+esc(jcClient(v.jcIds[0])):''}</span></div>`;
      });
      h+=`<div class="cell ${dim} ${today}" data-date="${k}">
        <span class="dnum">${d.getDate()}</span>${evHtml}</div>`;
      d.setDate(d.getDate()+1);
    }
    h+=`</div>`;
  }
  h+=`</div>`;
  el.calHost.innerHTML=h;
  wireMonthInteractions();
}

function wireMonthInteractions(){
  el.calHost.querySelectorAll(".cell").forEach(cell=>{
    cell.addEventListener("click",e=>{
      if(e.target.closest(".ev")) return;
      openVisitModal(null,{date:cell.dataset.date});
    });
    cell.addEventListener("dragover",e=>{e.preventDefault();cell.classList.add("drop");});
    cell.addEventListener("dragleave",()=>cell.classList.remove("drop"));
    cell.addEventListener("drop",async e=>{
      e.preventDefault();cell.classList.remove("drop");
      const id=e.dataTransfer.getData("text/id");
      if(id) await rescheduleToDate(id,cell.dataset.date);
    });
  });
  el.calHost.querySelectorAll(".ev").forEach(ev=>{
    ev.addEventListener("click",e=>{e.stopPropagation();openDetail(ev.dataset.id);});
    ev.addEventListener("dragstart",e=>e.dataTransfer.setData("text/id",ev.dataset.id));
  });
}

// ---------- WEEK / DAY (time grid) ----------
function startOfWeek(d){ const s=new Date(d); s.setDate(d.getDate()-d.getDay()); s.setHours(0,0,0,0); return s; }
const DAY_START=6, DAY_END=20; // 06:00–20:00 visible
function renderWeek(){ renderTimeGrid(7); }
function renderDay(){ renderTimeGrid(1); }

function renderTimeGrid(ncols){
  const days=[];
  if(ncols===7){ const s=startOfWeek(cursor); for(let i=0;i<7;i++){ const dd=new Date(s); dd.setDate(s.getDate()+i); days.push(dd);} 
    setPeriod(`${days[0].getDate()} ${MONTHS[days[0].getMonth()].slice(0,3)} – ${days[6].getDate()} ${MONTHS[days[6].getMonth()].slice(0,3)} ${days[6].getFullYear()}`);
  } else { const dd=new Date(cursor); dd.setHours(0,0,0,0); days.push(dd); setPeriod(`${DOW[dd.getDay()]} ${dd.getDate()} ${MONTHS[dd.getMonth()]} ${dd.getFullYear()}`); }

  const vis=filteredVisits();
  const todayKey=dateToKey(new Date());
  const colTmpl=`70px repeat(${days.length},1fr)`;

  let head=`<div class="tg-head" style="grid-template-columns:${colTmpl}"><div class="corner"></div>`;
  days.forEach(dd=>{ const t=dateToKey(dd)===todayKey?"today":""; head+=`<div class="col ${t}"><div class="w">${DOW[dd.getDay()]}</div><div class="d">${dd.getDate()}</div></div>`; });
  head+=`</div>`;

  // body grid
  let grid=`<div class="tg-grid" style="grid-template-columns:${colTmpl}">`;
  // hour label column
  grid+=`<div class="hour-col">`;
  for(let hh=DAY_START;hh<DAY_END;hh++) grid+=`<div class="hour-lbl">${String(hh).padStart(2,"0")}:00</div>`;
  grid+=`</div>`;
  // day columns
  days.forEach(dd=>{
    const k=dateToKey(dd);
    grid+=`<div class="day-col" data-date="${k}">`;
    for(let hh=DAY_START;hh<DAY_END;hh++) grid+=`<div class="slot" data-date="${k}" data-hour="${hh}"></div>`;
    // events for this day
    const dayVis=vis.filter(v=>dayKey(v.start)===k);
    // conflict map (per tech overlap)
    dayVis.forEach(v=>{
      const sd=utcToSast(v.start), ed=v.end?utcToSast(v.end):new Date(sd.getTime()+3600000);
      const sH=sd.getUTCHours()+sd.getUTCMinutes()/60;
      const eH=ed.getUTCHours()+ed.getUTCMinutes()/60;
      const top=(Math.max(sH,DAY_START)-DAY_START)*52;
      const height=Math.max(22,(Math.min(eH,DAY_END)-Math.max(sH,DAY_START))*52-2);
      const c=TYPE_COLOR[v.type]||"#9aa3ad";
      const conf=hasConflict(v,dayVis)?"conflict":"";
      grid+=`<div class="tev ${conf}" data-id="${v.id}" style="top:${top}px;height:${height}px;background:${c}">
        <div class="ttime">${fmtTime(v.start)}${v.end?"–"+fmtTime(v.end):""}</div>
        <div>${esc(jcRef(v.jcIds[0])||v.subject)}</div>
        <div style="font-size:10px;opacity:.85;font-weight:600">${v.jcIds[0]&&jcClient(v.jcIds[0])?esc(jcClient(v.jcIds[0])):""}</div>
        <div style="font-size:10px;opacity:.7">${esc(v.techNames.join(", "))}</div></div>`;
    });
    grid+=`</div>`;
  });
  grid+=`</div>`;

  el.calHost.innerHTML=`<div class="timegrid">${head}<div class="tg-body">${grid}</div></div>`;
  // wire
  el.calHost.querySelectorAll(".slot").forEach(s=>{
    s.addEventListener("click",()=>openVisitModal(null,{date:s.dataset.date,hour:+s.dataset.hour}));
  });
  el.calHost.querySelectorAll(".tev").forEach(t=>{
    t.addEventListener("click",e=>{e.stopPropagation();openDetail(t.dataset.id);});
  });
}

function hasConflict(v,sameDay){
  if(!ACTIVE_STATUSES.includes(v.status)) return false;
  const s=new Date(v.start).getTime(), e=v.end?new Date(v.end).getTime():s+3600000;
  return sameDay.some(o=>{
    if(o.id===v.id) return false;
    if(!ACTIVE_STATUSES.includes(o.status)) return false;
    if(!o.techIds.some(t=>v.techIds.includes(t))) return false;
    const os=new Date(o.start).getTime(), oe=o.end?new Date(o.end).getTime():os+3600000;
    return s<oe && os<e;
  });
}

