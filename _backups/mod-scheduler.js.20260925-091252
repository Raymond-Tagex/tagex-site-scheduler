// Workload dashboard search/filter (filters the visits list; KPIs stay weekly aggregates)
let dashFilter={q:'',tech:'',status:'',type:'',owner:''};
function renderDashVisits(){
  const body=document.getElementById('dashVisitsBody'); if(!body)return;
  const titleEl=document.getElementById('dashVisitsTitle');
  const vis=DATA.visits.map(normVisit).filter(v=>v.start);
  const f=dashFilter, active=f.q||f.tech||f.status||f.type||f.owner;
  let list;
  if(active){
    const q=(f.q||'').toLowerCase();
    list=vis.filter(v=>{
      if(f.tech && !v.techNames.includes(f.tech)) return false;
      if(f.status && v.status!==f.status) return false;
      if(f.type && v.type!==f.type) return false;
      if(f.owner && jcOwner(v.jcIds[0])!==f.owner) return false;
      if(q){ const hay=(v.subject+' '+jcRef(v.jcIds[0])+' '+jcClient(v.jcIds[0])+' '+jcOwner(v.jcIds[0])+' '+v.techNames.join(' ')).toLowerCase(); if(!hay.includes(q)) return false; }
      return true;
    }).sort((a,b)=>new Date(a.start)-new Date(b.start));
    if(titleEl) titleEl.textContent=`Results (${list.length})`;
  }else{
    list=vis.filter(v=>new Date(v.start)>=new Date(Date.now()-3600000) && ACTIVE_STATUSES.includes(v.status))
      .sort((a,b)=>new Date(a.start)-new Date(b.start)).slice(0,8);
    if(titleEl) titleEl.textContent='Upcoming Visits';
  }
  body.innerHTML=list.length?list.map(v=>`<tr style="cursor:pointer" data-act="openDetail" data-a1="${v.id}">
    <td style="white-space:nowrap">${fmtDateTime(v.start)}</td>
    <td>${esc(jcRef(v.jcIds[0]))}</td>
    <td>${esc(jcClient(v.jcIds[0])||"—")}</td>
