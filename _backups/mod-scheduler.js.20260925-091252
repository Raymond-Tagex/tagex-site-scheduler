// normalised visit object
function normVisit(rec){
  const f=rec.fields;
  const techIds=f[F.tech]||[];
  return {
    id:rec.id, subject:f[F.subject]||"", jcIds:f[F.jobcard]||[],
    start:f[F.start]||null, end:f[F.end]||null,
    techIds, techNames:techIds.map(i=>peopleById[i]||"?"),
    attIds:f[F.attendees]||[],
    type:selName(f[F.vtype]), status:selName(f[F.status]), priority:selName(f[F.priority]),
    notes:f[F.notes]||"", visitId:f[F.visitId]||"",
    ticketIds:f[F.ticket]||[]
  };
}
function jcLabel(jcId){ const f=jobcardById[jcId]; if(!f) return "(no JC)"; return (f[JC.ref]||"")+" — "+(f[JC.title]||""); }
function jcRef(jcId){ const f=jobcardById[jcId]; return f?(f[JC.ref]||""):""; }
function jcClient(jcId){ const f=jobcardById[jcId]; return f?joinArr(f[JC.clientName]):""; }
const OWNER_CATS=["PPA","SUB-RES","SUB-C&I","DIRECT-PURC"];
function jcOwner(jcId){ const f=jobcardById[jcId]; return f?joinArr(f[JC.owner]):""; }
function jcSite(jcId){ const f=jobcardById[jcId]; return f?joinArr(f[JC.site]):""; }

// apply filters
function filteredVisits(){
  const tech=el.filterTech.value, st=el.filterStatus.value, q=el.filterSearch.value.trim().toLowerCase();
  const own=(el.filterOwner&&el.filterOwner.value)||"";
  return DATA.visits.map(normVisit).filter(v=>{
    if(!v.start) return false;
    // Always exclude Cancelled visits from calendar unless user explicitly filters for them
    if(v.status==="Cancelled" && st!=="Cancelled") return false;
    if(tech && !v.techIds.includes(tech)) return false;
    if(st && v.status!==st) return false;
    if(own && jcOwner(v.jcIds[0])!==own) return false;
    if(q){
      const hay=(v.subject+" "+v.jcIds.map(jcLabel).join(" ")+" "+v.jcIds.map(jcClient).join(" ")+" "+v.jcIds.map(jcSite).join(" ")+" "+v.jcIds.map(jcOwner).join(" ")).toLowerCase();
      if(!hay.includes(q)) return false;
    }
    return true;
  });
}

