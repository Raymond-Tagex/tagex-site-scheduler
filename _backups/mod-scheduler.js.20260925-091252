// ── Tickets: detail ────────────────────────────────────────────────────────
async function omOpenTicket(id){
  const rec=omTktData.find(r=>r.id===id); if(!rec)return;
  omTktDetailId=id; omPrevView=omCurrentView; omCurrentView='tktdetail';
  document.querySelectorAll('.om-view').forEach(v=>v.classList.remove('active'));
  const host=document.getElementById('om-view-tktdetail');
  host.classList.add('active');
  host.innerHTML='<div class="om-loading"><span class="om-sp"></span>Loading ticket\u2026</div>';

  // Fetched fresh rather than read from the 60-second cache: this is the screen someone acts
  // on, and a stale status here is a second visit booked against a closed fault.
  let acts=[], spares=[];
  try{
    const all=await omFetchFiltered(OM_T.ACT);
    acts=all.filter(r=>[].concat(r.fields[OM_F.AL_TICKET]||[]).includes(id));
  }catch(e){ acts=null; }
  try{
    spares=(await spareAll()).filter(r=>[].concat(r.fields[TKS.ticket]||[]).includes(id));
  }catch(e){ spares=null; }
  omBuildTicket(rec,acts,spares);
}


function omBuildTicket(rec,acts,spares){
  const f=rec.fields, jc=omTktJc(rec);
  const st=omFstr(f,TK.status)||'New';
  const pri=omFstr(f,TK.priority)||'Normal';
  const ref=omFstr(f,TK.ref)||'\u2014';
  // DATA.visits holds raw records; normVisit is what turns one into the shape the calendar
  // and every other reader uses.
  const visits=[].concat(f[TK.visits]||[])
    .map(vid=>DATA.visits.find(v=>v.id===vid)).filter(Boolean).map(normVisit)
    .sort((x,y)=>String(x.start).localeCompare(String(y.start)));

  const facts=[
    ['Job card', jc?omFstr(jc.fields,OM_F.JC_REF):''],
    ['Client', jc?omCli(jc.fields):''],
    ['Site', jc?omFstr(jc.fields,OM_F.JC_SITE):''],
    ['Reported via', omFstr(f,TK.channel)],
    ['Source', omFstr(f,TK.channelDetail)],
    ['Reported by', omFstr(f,TK.reportedBy)],
    ['Reported at', f[TK.reportedAt]?fmtDateTime(f[TK.reportedAt]):''],
    ['Category', omFstr(f,TK.category)],
    ['Asset', omFstr(f,TK.asset)],
    ['Error code', omFstr(f,TK.errCode)],
  ].filter(([,v])=>v).map(([k,v])=>
    `<div class="om-fact"><span>${esc(k)}</span><b>${esc(v)}</b></div>`).join('');

  const visitRows=visits.length?visits.map(v=>
    `<div class="om-tli"><div class="om-tld g"></div>
      <div class="om-tlt">${esc(fmtDate(v.start))} ${esc(fmtTime(v.start))} \u00b7 <span style="color:var(--accent)">${esc(v.type||'')}</span> \u00b7 ${esc(v.status||'')}</div>
      <div class="om-tltx">${esc(v.techNames.join(', ')||'unassigned')}${v.notes?' \u2014 '+esc(v.notes):''}</div>
    </div>`).join('')
    :'<div class="om-empty">No visits booked against this ticket yet.</div>';

  const spareRows = spares===null
    ? '<div class="om-err">Spares could not be read.</div>'
    : spares.length?(`<table class="om-tbl"><tr><th>Code</th><th>Description</th><th>Req</th><th>Issued</th><th>Status</th></tr>`
      +spares.map(sp=>`<tr><td>${esc(omFstr(sp.fields,TKS.code))}</td><td>${esc(omFstr(sp.fields,TKS.desc))}</td>`
        +`<td>${esc(String(sp.fields[TKS.qtyReq]??''))}</td><td>${esc(String(sp.fields[TKS.qtyIssued]??''))}</td>`
        +`<td>${esc(omFstr(sp.fields,TKS.status))}</td></tr>`).join('')+'</table>')
    :'<div class="om-empty">No spares requested.</div>';

  const actRows = acts===null
    ? '<div class="om-err">The activity log could not be read.</div>'
    : acts.length?acts.map((a,i)=>{
        const typ=omFstr(a.fields,OM_F.AL_TYPE);
        return `<div class="om-tli"><div class="om-tld ${i===0?'g':''}"></div>
          <div class="om-tlt">${esc(fmtDateTime(a.createdTime))}${typ?` \u00b7 <span style="color:var(--accent)">${esc(typ)}</span>`:''}</div>
          <div class="om-tltx">${esc(omFstr(a.fields,OM_F.AL_NOTE)||'(no note)')}</div></div>`;
      }).join('')
    :'<div class="om-empty">Nothing logged against this ticket yet.</div>';

  const closed=['Resolved','Closed','Cancelled'].includes(st);
  const canEdit=TX.can('tickets','edit');
  const statusBtns=TICKET_STATUSES.filter(x=>x!==st).map(x=>
    `<button class="btn ghost sm" data-act="omTktStatus" data-a1="${esc(rec.id)}" data-a2="${esc(x)}">${esc(x)}</button>`).join('');

  document.getElementById('om-view-tktdetail').innerHTML=`
    <div class="om-dhead">
      <button class="btn ghost sm" data-act="omCloseTicket">\u2190 Back</button>
      <div style="flex:1;min-width:0">
        <div class="om-dref">${esc(ref)}</div>
        <div class="om-dtitle">${esc(omFstr(f,TK.subject)||'(no subject)')}</div>
      </div>
      <span class="om-sb ${omStCls(st)}">${esc(st)}</span>
      <span class="om-pb ${omPrCls(pri)}">${esc(pri)}</span>
    </div>
    <div class="om-dbody">
      <div class="om-acts">
        ${closed?'':`<button class="btn sm" data-act="omSecondVisit" data-a1="${esc(rec.id)}">\ud83d\udcc5 Schedule second visit</button>`}
        ${TX.can('tickets','export')?`<button class="btn ghost sm" data-act="omTktReport" data-a1="${esc(rec.id)}">\ud83d\udcc4 Download report</button>`:''}
      </div>
      <div class="om-fcard"><div class="om-fttl">Ticket</div><div class="om-facts">${facts}</div>
        ${canEdit&&!jc?`
        <div style="margin-top:10px">
          <div class="om-hint">No job card is linked to this ticket. Without one it cannot carry a site visit, and its report prints without the client and site.</div>
          <select id="om-tktjcsel" data-search="job cards" style="margin-top:6px"></select>
          <div id="om-tktjcmsg"></div>
          <button class="btn sm" data-act="omTktAttachJc" data-a1="${esc(rec.id)}" style="margin-top:8px">Attach job card</button>
        </div>`:''}
      </div>
      ${omFstr(f,TK.desc)?`<div class="om-fcard"><div class="om-fttl">Description</div><div class="om-tltx">${esc(omFstr(f,TK.desc))}</div></div>`:''}
      <div class="om-fcard"><div class="om-fttl">Site visits</div>${visitRows}</div>
      <div class="om-fcard"><div class="om-fttl">Spares</div>${spareRows}
        ${canEdit&&!closed?`
        <div style="margin-top:10px">
          <div id="om-tktstage"></div>
          <select id="om-tktsparesel" data-search="stock items" data-on="change" data-act="omTktPickSpare" data-a1="@val">
            <option value="">Loading\u2026</option>
          </select>
          <div class="om-hint" id="om-tktsparemsg"></div>
          <button class="btn sm" id="om-tktspareadd" hidden data-act="omTktRequestSpares" data-a1="${esc(rec.id)}"
                  style="margin-top:8px">Request these spares</button>
        </div>`:''}
      </div>
      ${omFstr(f,TK.resolution)?`<div class="om-fcard"><div class="om-fttl">Resolution</div><div class="om-tltx">${esc(omFstr(f,TK.resolution))}</div>${f[TK.closedAt]?`<div class="om-jcmeta">Closed ${esc(fmtDateTime(f[TK.closedAt]))}</div>`:''}</div>`:''}
      <div class="om-fcard"><div class="om-fttl">Move to</div><div class="om-acts">${statusBtns}</div><div id="om-tktmsg"></div></div>
      <div class="om-fcard"><div class="om-fttl">Activity</div>${actRows}</div>
    </div>`;

  // Built just now, so pick.js has not seen either select. The job card list is already in
  // memory; the stock catalogue is fetched on demand.
  omTktSpares=[];
  const jcSel=document.getElementById('om-tktjcsel');
  if(jcSel){
    jcSel.innerHTML='<option value="">\u2014 Select a job card \u2014</option>'
      +[...omJcData].sort((a,b)=>String(b.fields[OM_F.JC_REF]||'').localeCompare(String(a.fields[OM_F.JC_REF]||'')))
        .map(r=>`<option value="${esc(r.id)}">${esc(omFstr(r.fields,OM_F.JC_REF)+' \u2014 '+omCli(r.fields))}</option>`).join('');
    TX.pick.scan(document.getElementById('om-view-tktdetail'));
  }
  omTktWireSpares();
  omTktRenderSpares();
}

/**
 * Book the return trip for a ticket.
 *
 * It reuses openVisitModal rather than building a second form, so the technician-conflict
 * check still runs. A parallel form would be the one place a double-booking could slip out.
 */
function omSecondVisit(id){
  const rec=omTktData.find(r=>r.id===id); if(!rec)return;
  const jcId=[].concat(rec.fields[TK.jc]||[])[0];
  if(!jcId){ toast('That ticket has no job card, so a visit cannot be booked from it','bad'); return; }
  openVisitModal(null,{
    jcId, ticketId:id, type:'Return Visit',
    prio:omFstr(rec.fields,TK.priority)||'Normal',
  });
}

/**
 * Download the ticket's report.
 *
 * The page sends a record id and gets back a finished PDF. Everything in it is read on the
 * server under this role's own permissions, which is the only way a report can be trusted not
 * to print a field the reader is not allowed to see.
 *
 * tickets:export is Operations and Admin. A Technician gets a plain refusal, not a broken
 * download.
 */
async function omTktReport(id){
  const btn=document.querySelector('[data-act="omTktReport"]');
  const was=btn?btn.textContent:'';
  if(btn){ btn.disabled=true; btn.textContent='Building\u2026'; }
  try{
    const r=await TX.request('/api/ticket-report',{ ticketId:id });
    // base64 -> bytes. A PDF is binary; anything that treats it as text corrupts it.
    const bin=atob(r.content);
    const bytes=new Uint8Array(bin.length);
    for(let i=0;i<bin.length;i++) bytes[i]=bin.charCodeAt(i);
    const url=URL.createObjectURL(new Blob([bytes],{type:r.contentType||'application/pdf'}));
    const a=document.createElement('a');
    a.href=url; a.download=r.filename||'ticket-report.pdf';
    document.body.appendChild(a); a.click(); a.remove();
    // Revoked on a later turn of the loop: revoking immediately cancels the download in
    // some browsers before it has started.
    setTimeout(()=>URL.revokeObjectURL(url),30000);
    toast('Report downloaded','ok');
  }catch(e){
    toast('Report failed: '+TX.errorText(e),'bad');
  }finally{
    if(btn){ btn.disabled=false; btn.textContent=was; }
  }
}

// ── requesting spares without a visit ──────────────────────────────────────
//
// A spare row can name the visit it is for, and when one is booked it does. But the warehouse
// wants to know what is needed as soon as anybody knows it, which is usually before a date has
// been agreed. So parts can be asked for against the ticket alone; saveVisit then attaches any
// that are still loose to the visit it creates.

function omTktRenderSpares(){
  const host=document.getElementById('om-tktstage'); if(!host)return;
  host.innerHTML=omTktSpares.length?omTktSpares.map((l,i)=>
    `<div class="om-spare">
       <div class="om-sparetxt"><b>${esc(l.code)}</b><span>${esc(l.desc)}</span></div>
       <div class="om-stepper">
         <button type="button" class="om-step" data-act="omTktSpareStep" data-a1="${i}" data-a2="dec" aria-label="One fewer">\u2212</button>
         <span class="om-qty">${l.qty}</span>
         <button type="button" class="om-step" data-act="omTktSpareStep" data-a1="${i}" data-a2="inc" aria-label="One more">+</button>
         <button type="button" class="om-step om-x" data-act="omTktSpareStep" data-a1="${i}" data-a2="rm" aria-label="Remove">\u00d7</button>
       </div>
     </div>`).join('')
    :'';
  const btn=document.getElementById('om-tktspareadd');
  if(btn) btn.hidden=!omTktSpares.length;
}

function omTktSpareStep(i,what){
  const line=omTktSpares[+i]; if(!line)return;
  if(what==='inc') line.qty+=1;
  else if(what==='dec') line.qty=Math.max(1,line.qty-1);
  else omTktSpares.splice(+i,1);
  omTktRenderSpares();
}

function omTktPickSpare(v){
  const item=(STOCK||[]).find(x=>x.id===v); if(!item)return;
  const have=omTktSpares.find(l=>l.id===item.id);
  if(have) have.qty+=1;                  // twice means two of it, not two lines
  else omTktSpares.push({id:item.id,code:item.code,desc:item.desc,unit:item.unit,qty:1});
  const sel=document.getElementById('om-tktsparesel'); if(sel) sel.value='';
  omTktRenderSpares();
}

/** Fill the ticket screen's picker, lazily, the first time the screen is drawn. */
function omTktWireSpares(){
  const sel=document.getElementById('om-tktsparesel');
  const msg=document.getElementById('om-tktsparemsg');
  if(!sel||!msg) return;
  msg.textContent='Loading the stock catalogue\u2026';
  loadStock().then((rows)=>{
    sel.innerHTML='<option value="">\u2014 search the stock catalogue \u2014</option>'
      +rows.map(x=>`<option value="${esc(x.id)}">${esc(x.code+(x.desc?' \u2014 '+x.desc:''))}</option>`).join('');
    TX.pick.scan(document.getElementById('om-view-tktdetail'));
    msg.textContent=rows.length+' item'+(rows.length===1?'':'s')+' \u00b7 type a code or a description';
  }).catch((e)=>{
    msg.innerHTML='<span class="om-err">The stock catalogue could not be read: '+esc(TX.errorText(e))+'</span>';
  });
}

async function omTktRequestSpares(id){
  if(!omTktSpares.length) return;
  const rec=omTktData.find(r=>r.id===id); if(!rec)return;
  const msg=document.getElementById('om-tktsparemsg');
  const btn=document.getElementById('om-tktspareadd');
  if(btn){ btn.disabled=true; btn.textContent='Saving\u2026'; }
  const problems=[], saved=[];
  for(const line of omTktSpares){
    try{
      await spareCreate({
        [TKS.ticket]:[id],
        [TKS.code]:line.code, [TKS.desc]:line.desc, [TKS.unit]:line.unit,
        [TKS.srcId]:line.id, [TKS.qtyReq]:line.qty, [TKS.status]:'Requested',
      });
      saved.push(line);
    }catch(e){ problems.push(line.code+': '+e.message); }
  }
  if(saved.length){
    try{
      await omPost(OM_T.ACT,{
        [OM_F.AL_NOTE]:'Spares requested (no visit booked yet):\n'
          +saved.map(l=>l.qty+' \u00d7 '+l.code+(l.desc?' ('+l.desc+')':'')).join('\n'),
        [OM_F.AL_JC]:[].concat(rec.fields[TK.jc]||[]),
        [OM_F.AL_TICKET]:[id],
        [OM_F.AL_TYPE]:'Spares Requested',
      });
    }catch(e){ problems.push('the activity entry: '+e.message); }
    // A closed ticket is not reopened by asking for a part; anything still live is now waiting.
    const st=omFstr(rec.fields,TK.status)||'New';
    if(!['Resolved','Closed','Cancelled'].includes(st)){
      try{
        const up=await tktUpdate(id,{[TK.status]:'Awaiting Spares'});
        if(up) Object.assign(rec.fields,up.fields);
      }catch(e){ problems.push('the ticket status: '+e.message); }
    }
  }
  omTktSpares=[];
  if(problems.length) toast('Saved what it could. These did not: '+problems.join('; '),'bad');
  else toast(saved.length+' spare'+(saved.length===1?'':'s')+' requested','ok');
  omUpdateTktBadge();
  omOpenTicket(id);
}

// ── attaching a job card that was never recorded ───────────────────────────
//
// The form that raised the migrated tickets asked for a job card and then did not save it, so
// six of them arrived with the link empty. Rather than a one-off script, the screen can do it:
// a ticket that loses its job card for any reason is fixable in the app.

async function omTktAttachJc(id){
  const sel=document.getElementById('om-tktjcsel');
  const jcId=sel?sel.value:'';
  const msg=document.getElementById('om-tktjcmsg');
  if(!jcId){ if(msg) msg.innerHTML='<div class="om-err">\u26a0 Choose a job card first</div>'; return; }
  const rec=omTktData.find(r=>r.id===id); if(!rec)return;
  const jc=omJcData.find(r=>r.id===jcId);
  if(msg) msg.innerHTML='<div class="om-loading"><span class="om-sp"></span>Attaching\u2026</div>';
  try{
    const patch={[TK.jc]:[jcId]};
    // The client comes with it, unless the ticket already names one.
    const cli=jc?[].concat(jc.fields[OM_F.JC_CLI]||[]):[];
    if(cli.length && !(rec.fields[TK.client]||[]).length) patch[TK.client]=cli;
    const up=await tktUpdate(id,patch);
    if(up) Object.assign(rec.fields,up.fields);
    try{
      await omPost(OM_T.ACT,{
        [OM_F.AL_NOTE]:'['+(omFstr(rec.fields,TK.ref)||'')+'] Job card attached: '
          +(jc?omFstr(jc.fields,OM_F.JC_REF):jcId)
          +' \u2014 it was not recorded when the ticket was raised.',
        [OM_F.AL_JC]:[jcId],
        [OM_F.AL_TICKET]:[id],
        [OM_F.AL_TYPE]:'Comment',
      });
    }catch(e){ toast('Job card attached, but not logged: '+e.message,'bad'); }
    omOpenTicket(id);
  }catch(e){
    if(msg) msg.innerHTML='<div class="om-err">\u2715 '+esc(e.message)+'</div>';
  }
}

