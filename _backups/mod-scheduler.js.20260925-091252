  const ownerOpts=`<option value="">All owner categories</option>`+allOwners.map(t=>`<option>${esc(t)}</option>`).join("");

  let h=`
  <div class="grid-cards">
    <div class="kcard accent"><div class="label">Visits Today</div><div class="val">${today.length}</div><div class="sub">${todayKey.split("-").reverse().join("/")}</div></div>
    <div class="kcard"><div class="label">Active Now</div><div class="val">${activeNow.length}</div><div class="sub">Scheduled · Confirmed · In Progress</div></div>
    <div class="kcard"><div class="label">Completed (wk)</div><div class="val">${completedWk.length}</div><div class="sub">of ${week.length} this week</div></div>
    <div class="kcard ${emergWk.length?'bad':''}"><div class="label">Emergency (wk)</div><div class="val">${emergWk.length}</div><div class="sub">callouts this week</div></div>
  </div>

  <div class="panel">
    <h3><span class="bar"></span>Technician Workload — This Week</h3>
    <div class="twrap"><table>
      <thead><tr><th>Technician</th><th style="width:40%">Visits</th><th>Hours Scheduled</th><th>Emergency</th></tr></thead>
      <tbody>
      ${techRows.length?techRows.map(([n,d])=>`<tr>
        <td>${esc(n)}</td>
        <td><div class="barcell"><div class="bar-track"><div class="bar-fill" style="width:${(d.visits/maxV*100).toFixed(0)}%"></div></div><b>${d.visits}</b></div></td>
        <td>${(d.minutes/60).toFixed(1)} h</td>
        <td>${d.emerg?`<span class="chip" style="background:var(--bad);color:#fff">${d.emerg}</span>`:"—"}</td>
