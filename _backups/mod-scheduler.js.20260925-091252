/**
 * Move a ticket's status, and say so in its activity.
 *
 * Resolved and Closed stamp Closed At. The log entry names both the old and the new status,
 * because "Status Change" on its own tells you nothing six months later.
 */
async function omTktStatus(id,next){
  const rec=omTktData.find(r=>r.id===id); if(!rec)return;
  const msg=document.getElementById('om-tktmsg');
  const was=omFstr(rec.fields,TK.status)||'New';
  if(was===next) return;
  if(msg) msg.innerHTML='<div class="om-loading"><span class="om-sp"></span>Saving\u2026</div>';
  try{
    const patch={[TK.status]:next};
    if(['Resolved','Closed'].includes(next) && !rec.fields[TK.closedAt]){
      patch[TK.closedAt]=new Date().toISOString();
    }
    const updated=await tktUpdate(id,patch);
    if(updated) Object.assign(rec.fields,updated.fields);
    try{
      await omPost(OM_T.ACT,{
        [OM_F.AL_NOTE]:'['+(omFstr(rec.fields,TK.ref)||'')+'] Status '+was+' \u2192 '+next,
        [OM_F.AL_JC]:[].concat(rec.fields[TK.jc]||[]),
        [OM_F.AL_TICKET]:[id],
        [OM_F.AL_TYPE]:'Ticket Status Change',
      });
    }catch(logErr){
      if(msg) msg.innerHTML='<div class="om-ok">\u2713 Now '+esc(next)+'</div>'
        +'<div class="om-err">\u26a0 Not written to the activity log: '+esc(logErr.message)+'</div>';
      omUpdateTktBadge();
      return;
    }
    omUpdateTktBadge();
    omOpenTicket(id);
  }catch(e){
    if(msg) msg.innerHTML='<div class="om-err">\u2715 '+esc(e.message)+'</div>';
  }
}

