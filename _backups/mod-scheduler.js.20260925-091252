// ── API SHIM — replaces the six functions that used to hold a PAT ────────────
//
// Same names, same signatures, same return shapes, so the 1,300 lines below are unchanged.
// Only the transport moved: every call now goes through TX.api -> /api/at, which enforces
// the permission matrix server-side.
//
// The app addresses Airtable fields by ID (returnFieldsByFieldId), which the proxy supports —
// it resolves ids against the live schema before applying field rules, so a denied field is
// stripped whichever way the record is keyed.

// Airtable table ids -> the proxy's symbolic names. The client may never send a raw tbl… id;
// the proxy rejects the request before it authenticates if it sees one.
const SYM = {
  tblny4UUKq8OIHQlw: 'site_visits',
  tbl2wqnfM0eDa8M7P: 'job_cards',
  tblYXKBqfN4zituh1: 'people',
  tblWSJlbiGWlZ6yGL: 'activity_log',
  tblljzSDboKGUJAXg: 'clients',
  People: 'people',            // the tickets module refers to People by name
};

function symbolFor(table) {
  const s = SYM[table];
  if (!s) throw new Error(`Table "${table}" is not available to this application.`);
  return s;
}

async function atGet(table, fields) {
  const r = await TX.list('OM', symbolFor(table), {
    fields: (fields && fields.length) ? fields : undefined,
    pageSize: 100,
    returnFieldsByFieldId: true,
  });
  return r.records || [];
}

async function atCreate(table, fields /* , typecast */) {
  // typecast is deliberately ignored — the proxy validates against the live schema instead,
  // and rejects an invalid value by name rather than silently coercing it.
  const r = await TX.api({
    op: 'create', base: 'OM', table: symbolFor(table), fields,
    params: { returnFieldsByFieldId: true },
  });
  return (r.records || [])[0];
}

async function atUpdate(table, id, fields /* , typecast */) {
  const r = await TX.api({
    op: 'update', base: 'OM', table: symbolFor(table), recordId: id, fields,
    params: { returnFieldsByFieldId: true },
  });
  return (r.records || [])[0];
}

