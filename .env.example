# ─────────────────────────────────────────────────────────────
# TAGEX Operations Platform — environment variables
#
# Copy to .env.local for local dev (`vercel dev`).
# For production set these in: Vercel → Project → Settings → Environment Variables
#
# NEVER commit real values. .env* is git-ignored (except this file).
# Every value below is a PLACEHOLDER. Do not paste a real token into this file.
# ─────────────────────────────────────────────────────────────


# ── Airtable ─────────────────────────────────────────────────
# THE service Personal Access Token. ONE token, held only on the server, never sent to a
# browser. This replaces the old model where every warehouse user pasted a PAT into the app.
#
# Required scopes:
#   data.records:read
#   data.records:write
#   schema.bases:read
#
# Required base access — all THREE:
#   TAGEX – C&I Operations Platform   appfzAX5YHqg4UXCl
#   TAGEX – O&M Platform              app0tq4y9wH10h6Up
#   TAGEX – Identity & Access         appVrQ4Nuwb9gk6Ip
AIRTABLE_PAT=patXXXXXXXXXXXXXX.XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX


# ── Sessions ─────────────────────────────────────────────────
# Signing key for session cookies. Minimum 32 characters; the app refuses to start without it.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Rotating this signs everyone out immediately — which is also how you kill every session at once.
JWT_SECRET=replace-me-with-at-least-32-random-characters

# Absolute session lifetime, in hours. Not extended by activity.
SESSION_TTL_HOURS=8

# Idle timeout, in minutes. Sliding: refreshed on activity.
# Any session that reads restricted personal data drops to 15 minutes for the rest of its life.
IDLE_TIMEOUT_MINUTES=30



# Two-factor authentication for admin-capable roles. Default: FALSE.
#
# Sign-in is email + password only. Set to exactly "true" to force administrators to enrol
# in TOTP two-factor. Any other value leaves it off.
#
# With this off, one password is the only barrier to the FICA / personal records in the C&I
# base, to user management, and to permission editing. Account lockout (5 attempts, 15 min)
# and the audit trail still apply, but neither stops someone who has the correct password.
#
# A user who switches MFA on for their own account is still challenged at login. This flag
# only controls whether it is FORCED on administrators.
REQUIRE_ADMIN_MFA=false
# ── Migration flag ───────────────────────────────────────────
# pat     — legacy: each user pastes their own Airtable token (the model being retired)
# session — email + password login, all Airtable traffic through /api/at
#
# Roll out as: preview=session, production=pat → prove it → production=session →
# keep pat available one working day as rollback → remove.
AUTH_MODE=session


# ── Email (Resend) ───────────────────────────────────────────
# Used for delivery note PDFs, user invitations and password resets.
# Without it: saving and printing still work; email and invites return a clear error.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Sender address. Must be on a domain VERIFIED at https://resend.com/domains
FROM_EMAIL=delivery@tagexenergy.co.za

# Origin used to build invite and password-reset links. Set this in production so the links
# point at the real site rather than whatever Host header the request happened to carry.
APP_ORIGIN=https://tagex-delivery-vercel.vercel.app

# ─────────────────────────────────────────────────────────────
# SHARED IDENTITY
#
# This deployment uses the SAME identity base, the SAME user accounts and the SAME four
# roles as the delivery app. One account signs in to both; there is nothing extra to set up
# for a user who already exists.
#
# AIRTABLE_PAT should be the same service token — it already reaches all three bases.
#
# JWT_SECRET should be DIFFERENT from the delivery app's. Cookies are per-domain so they
# never cross anyway, and a separate secret means a token lifted from one deployment cannot
# be replayed against the other.
# ─────────────────────────────────────────────────────────────
